PLAGAI_DATABASE_URL=sqlite:///./plagai.db
PLAGAI_ADMIN_TOKEN=replace-with-a-long-random-secret
PLAGAI_AI_MODEL_DIR=./artifacts/ai-detector
PLAGAI_CORPUS_DIR=./artifacts/corpus
PLAGAI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PLAGAI_PLAG_PARAPHRASE_THRESHOLD=0.80
PLAGAI_WORDS_PER_CREDIT=100
PLAGAI_MIN_CREDITS_PER_CALL=1
PLAGAI_RATE_LIMIT_PER_MINUTE=60
# Optional: web-source plagiarism search
PLAGAI_BRAVE_API_KEY=
